# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave blank to use SQLite (local dev without Docker)
# Set to Postgres connection string for production or Docker-based local dev
DATABASE_URL=

# PostgreSQL (when using Docker Compose locally)
# DATABASE_URL=postgresql://propmanager:propmanager@localhost:5432/propmanager

# CORS — comma-separated origins allowed to access the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudinary (document/PDF storage)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email
# Set BREVO_API_KEY to use Brevo REST API (preferred for Render free tier)
# Or set SMTP vars for any other provider
# Leave unset to log to console (dev mode)
# BREVO_API_KEY=xkeysib-...
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-api-key
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=noreply@propmanager.com

# Production (set these in Render dashboard)
# DEBUG=False
# ALLOWED_HOSTS=.onrender.com,yourdomain.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev
