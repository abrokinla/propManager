# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave blank to use SQLite (local dev without Docker)
# Set to Postgres connection string for production or Docker-based local dev
DATABASE_URL=

# PostgreSQL (when using Docker Compose locally)
# DATABASE_URL=postgresql://propmanager:propmanager@localhost:5432/propmanager

# CORS — comma-separated origins allowed to access the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudflare R2 (document storage)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=propmanager-documents
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com

# SendGrid (email)
# SENDGRID_API_KEY=
# DEFAULT_FROM_EMAIL=noreply@propmanager.com

# Production (set these in Render dashboard)
# DEBUG=False
# ALLOWED_HOSTS=.onrender.com,yourdomain.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev
